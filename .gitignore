# ─────────────────────────────────────────────────────────────
# .gitignore — Profiler de Dados
# Protege dados brutos e outputs que podem conter informações
# sensíveis (PII, dados corporativos) de serem commitados.
# ─────────────────────────────────────────────────────────────

# Arquivos de dados brutos (inputs)
*.csv
*.xlsx
*.xls
*.parquet

# Outputs gerados (podem conter dados sensíveis)
*.json
*.txt
analise_*
!requirements.txt

# Ambiente virtual Python
.venv/
.venv_profiler/
venv/
env/

# Worktrees de desenvolvimento isolado (superpowers:using-git-worktrees)
.worktrees/

# Configuração local do Claude Code
.claude/settings.local.json

# Cache do Python
__pycache__/
*.py[cod]
*.pyo

# Artefatos de build/instalação editável (pip install -e)
*.egg-info/
build/
dist/
.pytest_cache/

# IDEs
.vscode/
.idea/
*.code-workspace

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Logs de execução (gerados pelo on_bad_lines="warn")
*.log